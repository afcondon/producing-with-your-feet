      "layout": "default",
      "controls": [
        { "type": "slider", "cc": 80, "label": "Loop level" },
        { "type": "toggle", "cc": 81, "label": "Click", "onLabel": "On", "offLabel": "Off" },
        { "type": "slider", "cc": 82, "label": "Click level" },
        { "type": "toggle", "cc": 83, "label": "Input monitor", "onLabel": "On", "offLabel": "Off",
          "description": "The interface's own direct monitoring is lower latency." }
      ]
    }
  ]
